{
  "realm": "orbyta",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "miembro",
        "description": "Miembro de una empresa"
      }
    ]
  },
  "clients": [
    {
      "clientId": "orbyta-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "empresa_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "empresa_id",
            "claim.name": "empresa_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orbyta-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana@empresa-a.test",
      "email": "ana@empresa-a.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Empresa A",
      "requiredActions": [],
      "attributes": {
        "empresa_id": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "prueba-ci-no-secreta",
          "temporary": false
        }
      ],
      "realmRoles": [
        "miembro"
      ]
    },
    {
      "username": "beto@empresa-b.test",
      "email": "beto@empresa-b.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Beto",
      "lastName": "Empresa B",
      "requiredActions": [],
      "attributes": {
        "empresa_id": [
          "22222222-2222-4222-8222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "prueba-ci-no-secreta",
          "temporary": false
        }
      ],
      "realmRoles": [
        "miembro"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\"}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\"}], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  }
}
