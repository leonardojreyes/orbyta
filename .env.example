# PostgreSQL local (Homebrew o Postgres.app).
# API: rol sin privilegios `orbyta_app` (lo crea `pnpm db:migrate`). RLS se aplica siempre con este rol.
DATABASE_URL=postgres://orbyta_app:orbyta_app@localhost:5432/orbyta
# Dueño del esquema (en Mac, tu usuario del sistema): solo para db:migrate, db:seed y db:reset.
DATABASE_ADMIN_URL=postgres://localhost:5432/orbyta
API_PORT=3001
