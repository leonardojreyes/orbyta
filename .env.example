# PostgreSQL local (Homebrew o Postgres.app).
# API: rol sin privilegios `orbyta_app` (lo crea `pnpm db:migrate`). RLS se aplica siempre con este rol.
DATABASE_URL=postgres://orbyta_app:orbyta_app@localhost:5432/orbyta
# Dueño del esquema (en Mac, tu usuario del sistema): solo para db:migrate, db:seed y db:reset.
DATABASE_ADMIN_URL=postgres://localhost:5432/orbyta
API_PORT=3001
# Solo si hay un proxy de confianza delante de la API (para que el límite de intentos use la IP real).
# TRUST_PROXY=true
# Orígenes web permitidos por CORS, separados por coma (en desarrollo no hace falta: la web usa el proxy de Vite).
# CORS_ORIGIN=https://orbyta.ejemplo.com
# Adjuntos (fotos de las órdenes). Hoy solo "local": archivos en STORAGE_DIR (por defecto ./storage, fuera de git).
# Hay que respaldar esa carpeta junto con la base de datos. Para S3 ver apps/api/src/storage.ts.
# STORAGE_DRIVER=local
# STORAGE_DIR=/ruta/a/storage
# MAX_UPLOAD_MB=5
