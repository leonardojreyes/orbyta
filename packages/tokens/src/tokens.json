{
  "color": {
    "$type": "color",
    "claro": {
      "fondo": { "$value": "#ffffff" },
      "superficie": { "$value": "#f4f5f7" },
      "texto": { "$value": "#14161a" },
      "texto-secundario": { "$value": "#4b5260" },
      "borde": { "$value": "#6b7280" },
      "primario": { "$value": "#1d4ed8" },
      "texto-sobre-primario": { "$value": "#ffffff" },
      "foco": { "$value": "#1d4ed8" },
      "exito": { "$value": "#166534" },
      "alerta": { "$value": "#92400e" },
      "error": { "$value": "#b91c1c" }
    },
    "oscuro": {
      "fondo": { "$value": "#0f1115" },
      "superficie": { "$value": "#1a1d23" },
      "texto": { "$value": "#f3f4f6" },
      "texto-secundario": { "$value": "#a8b0bd" },
      "borde": { "$value": "#8b93a1" },
      "primario": { "$value": "#7ea6ff" },
      "texto-sobre-primario": { "$value": "#0f1115" },
      "foco": { "$value": "#7ea6ff" },
      "exito": { "$value": "#4ade80" },
      "alerta": { "$value": "#fbbf24" },
      "error": { "$value": "#f87171" }
    }
  },
  "tipografia": {
    "familia": {
      "$type": "fontFamily",
      "base": { "$value": "'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif" }
    },
    "tamano": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" }
    },
    "peso": {
      "$type": "fontWeight",
      "normal": { "$value": 400 },
      "medio": { "$value": 500 },
      "negrita": { "$value": 600 }
    }
  },
  "espaciado": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "12": { "$value": "3rem" }
  },
  "radio": {
    "$type": "dimension",
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" }
  },
  "sombra": {
    "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.12)" },
    "md": { "$value": "0 4px 12px rgb(0 0 0 / 0.16)" }
  }
}
