{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "commonjs",
    "lib": [
      "es2022"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@orbyta/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@orbyta/ui": [
        "packages/ui/src/index.ts"
      ],
      "@orbyta/tokens": [
        "packages/tokens/src/index.ts"
      ],
      "@orbyta/ordenes-servicio-domain": [
        "./modules/ordenes-servicio/domain/src/index.ts"
      ],
      "@orbyta/ordenes-servicio-application": [
        "./modules/ordenes-servicio/application/src/index.ts"
      ],
      "@orbyta/ordenes-servicio-infrastructure": [
        "./modules/ordenes-servicio/infrastructure/src/index.ts"
      ],
      "@orbyta/ordenes-servicio-interface": [
        "./modules/ordenes-servicio/interface/src/index.ts"
      ],
      "@orbyta/ui/textos": [
        "packages/ui/src/i18n/index.ts"
      ],
      "@orbyta/ui/ejemplos": [
        "packages/ui/src/ejemplos/index.ts"
      ],
      "@orbyta/tokens/tema": [
        "packages/tokens/src/generado/tema.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
