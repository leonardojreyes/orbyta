{
  "name": "@orbyta/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "dev": "swc src -d dist --strip-leading-paths --config-file .swcrc && node --env-file-if-exists=../../.env.local dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@orbyta/modulo-ejemplo": "workspace:*",
    "@orbyta/tenancy": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.0.0",
    "vitest": "^4.1.11"
  }
}
