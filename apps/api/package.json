{
  "name": "@orbyta/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "dev": "swc src -d dist --strip-leading-paths --config-file .swcrc && node --env-file-if-exists=../../.env.local dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --passWithNoTests --exclude '**/*.e2e.test.ts' --exclude '**/node_modules/**' --exclude '**/dist/**'",
    "test:e2e": "vitest run --maxWorkers=1 src/e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@orbyta/archivos": "workspace:*",
    "@orbyta/auditoria": "workspace:*",
    "@orbyta/autorizacion": "workspace:*",
    "@orbyta/eventos": "workspace:*",
    "@orbyta/ia": "workspace:*",
    "@orbyta/identidad": "workspace:*",
    "@orbyta/modulo-ejemplo": "workspace:*",
    "@orbyta/tenancy": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "7.2.1",
    "oauth2-mock-server": "9.2.0",
    "supertest": "7.3.1",
    "vitest": "^4.1.11"
  }
}
